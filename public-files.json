{
  "_comment": "What the public mirror contains. A trailing / = whole folder, * = any characters inside one path part. exclude wins over include. CLAUDE.md is generated by scripts/release-public.mjs.",
  "include": [
    "src/", "bin/", "test/", "probe-app/", "demo-app/", "agent-helper/", "sample/server/", "profiles/", "judge/", "scenarios/", "flows/",
    "scripts/check-*.mjs", "scripts/ci-smoke.mjs", "scripts/social-preview.mjs", "examples/",
    "README.md", "README.ko.md", "CONTRIBUTING.md", "CODE_OF_CONDUCT.md", "SECURITY.md", "LICENSE", "CHANGELOG.md", "AGENTS.md",
    ".agents/", ".claude-plugin/", ".github/", ".mcp.json", ".gitignore",
    "server.json", "package.json", "package-lock.json", "tsconfig.json",
    "docs/guide-your-app.md",
    "docs/adr/0002-no-barrier.md", "docs/adr/0004-ai-exposure.md", "docs/adr/0006-fold.md", "docs/adr/0007-agent-helper.md", "docs/adr/0008-proxy-judge.md", "docs/adr/0009-wifi.md",
    "docs/measurements/*.md", "docs/measurements/*.json",
    "docs/demo/social-preview.png", "docs/demo/hero.gif", "docs/demo/hero.mp4", "docs/demo/vibe.gif"
  ],
  "exclude": [
    "scripts/check-hero.mjs", "scripts/check-layout.mjs", "scripts/check-surface.mjs", "scripts/check-demo-gif.mjs",
    "docs/measurements/coexist.*", "docs/measurements/ram-sweep.json", "docs/measurements/hero*", "docs/measurements/demo*.json"
  ]
}
