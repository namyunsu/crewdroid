<?xml version="1.0" encoding="utf-8"?>
<!-- Load app (T62, src/load.ts): makes the device look like a used phone. Start = trampoline that starts LoadService as a
     foreground service (allowed because an activity is on top); LoadService holds the memory ballast, runs the CPU workers,
     starts the Procs$Pn services (one process each) and keeps alarms/jobs firing. `am force-stop` undoes all of it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application android:label="crewdroid load">
        <activity android:name=".Start" android:exported="true" android:theme="@android:style/Theme.NoDisplay" android:excludeFromRecents="true" android:noHistory="true" />
        <service android:name=".LoadService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="test device background load" />
        </service>
        <service android:name=".Churn" android:exported="false" android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".Tick" android:exported="false" />
        <service android:name=".Procs$P1" android:process=":p1" android:exported="false" />
        <service android:name=".Procs$P2" android:process=":p2" android:exported="false" />
        <service android:name=".Procs$P3" android:process=":p3" android:exported="false" />
        <service android:name=".Procs$P4" android:process=":p4" android:exported="false" />
        <service android:name=".Procs$P5" android:process=":p5" android:exported="false" />
        <service android:name=".Procs$P6" android:process=":p6" android:exported="false" />
