{
  "mcpServers": {
    "mobile-mcp": {
      "command": "npx",
      "args": ["-y", "@mobilenext/mobile-mcp@1.0.12"],
      "env": { "MOBILEMCP_LEGACY_ROBOT": "1", "MOBILEMCP_DISABLE_TELEMETRY": "1" }
    },
    "maestro": {
      "command": "maestro",
      "args": ["mcp", "--no-viewer"]
    },
    "crewdroid": {
      "command": "npx",
      "args": ["tsx", "src/cli.ts", "mcp"]
    }
  }
}
