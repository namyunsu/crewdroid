{
  "name": "crewdroid",
  "version": "0.2.0",
  "description": "Android emulator for AI agents: light (1.4 GB RAM per device), a text screen outline instead of screenshots, per-device network, battery, location, screen and Android version. CLI + MCP server.",
  "type": "module",
  "bin": { "crewdroid": "bin/crewdroid.mjs" },
  "files": ["bin", "src", "profiles", "judge", "scenarios", "sample/server", "agent-helper/build/outputs/apk/release/crewdroid-agent-release.apk", "LICENSE", "README.md", "README.ko.md", "server.json"],
  "keywords": ["android", "emulator", "mcp", "mcp-server", "claude-code", "agent-skills", "mobile-testing", "concurrency"],
  "repository": { "type": "git", "url": "git+https://github.com/namyunsu/crewdroid.git" },
  "license": "MIT",
  "author": "Yunsu Nam",
  "mcpName": "io.github.namyunsu/crewdroid",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "node --import tsx -e \"import('./src/helper.ts').then((m) => m.buildHelper())\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "playwright": "1.64.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "tsx": "^4.23.15",
    "zod": "4.6.7"
  }
}
